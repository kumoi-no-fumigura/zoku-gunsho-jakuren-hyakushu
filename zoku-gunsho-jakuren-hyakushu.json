   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早蕨未遍",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "難波瀉あしの若葉の穂に出て招くと見ゆる駒のふり髪",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "○遥見春駒",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "尋らぬ人々そあとめあたら夜の月と国とにかへる雁かね",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁天帰雁",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "夕月夜露にまかふ山里に思ひかねける呼子とりかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕呼子鳥",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "苗代の水にうきねやまかすらん塩の声のあと伝ひ行",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蛙鳴苗代",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "色はみな昔なからも桃のはなふる枝や我を思ひ出らん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "故郷桃花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "唐衣きつゝ馴けん面影もなみまにうつす花の夕栄",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜若映水",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "色深きしのたの杜のつほ茎千枝の雫や雨に添らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜間茎菜",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "水の面に咲こほれたる山吹は下枝そきしのへたてなるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬添岸",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "賤の男る家路もくれぬ岩つゝしさけるあたりにつま木休めて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "樵路躑躅",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "藤波に千年の春や誠ぬらんけさ色かはす住の江の松",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤花初綻",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "ならひなき哀はなとか熱さらん春とて人の友おらぬかは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜春似友",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "人並に残る袂のかはるこそ花の衣は名さへおしけれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一四二庚戌亥夜",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "卯花を垣ねのまゝに詠れは出入門にめくりきにけり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花延宅",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "何方とよかるゝ里もしりおまし聞定めたる水鶏なりせは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鶏河方",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "こゝよひかく聞おらひなは郭公まれなるこゑにたゝん物かは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公如夢",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "引残す諸しのへとや菖蒲草涼しくかほる沼のいはかき",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "沼辺菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "槙の戸を明れはさけるたち国の花ちる里におしきすまひを",
   "kana": "",
   "speaker": "本ノマヽ",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "慮橋香砌",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "ことしたに馴ぬる程は知れけり咲すさびたる大和なてしこ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "久愛撫子",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "玉麓いふせき中のむつことを思ひしりても行ほたるかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蛍火過簾",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "迷ふへき災そ深き鵜飼舟此世も月の入を待ける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜鴉柯",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "射火ことねぬ夜つもれは他夫るををれ独やめをあわすらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜々村火",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "真柴分はやむる駒もとゝろきて木高くうつる蝉の諸声",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "馬上聞蝉",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "此世よりなつそふ池の蓬かなをらぬ袂に露移るまて",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "近見池蓮",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "故郷は岩もる水にすてかへて蓮や庭のあるし成らん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "家為夏栖",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "夏の日をみそきに捨るこよひかな月ゆへ船をまたぬ宿にも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "家々夏枝",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "吹過り風の音たにかはらすはけふも夏野の萩のうはかせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "風告秋使",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "こゝにこそねぬ夜なりとも天の川雲の外なる契たかふな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庚申七夕",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "行水にやかてしからみかけてけり花散さとの萩の下枝",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "蘇散遣水つにやかてし"
  },
  {
   "seq": "37",
   "text": "一山里にかこひ分たる女郎花曳もとのへのものと成らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "女郎花柿垣",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "風吹は下葉はかりそ刈堂のまかきのうちのものと見へける",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "刈萱乱袖",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "なつかしき光か手枕のあたりそと心をみたす薬かな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蘭香薫枕",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "さもこそは諸なき庭と荒果め夢路もたへぬ萩の上風",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩声驚夢",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "旅人のけしきにしたし花薄ひそかたおらすまゆく心は",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄妨往還",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "心をはつくしな果そ鹿の音に秋のねさめは今宵のみかは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寝覚聞鹿",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "初雁のかく玉章をまきよとてほのかに見する村雲の空",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲間初雁",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "並露にをき臥庭の浅茅原未葉にもとの雫とそ見る",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浅茅露室",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "夕風に飛たつ空やまゝふらん尾喜つたひに鶏なくなり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "勇中聞鶉",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "あれぬとて隣にいとふ中垣はあさかほさかぬ宿そ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隣花模",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "桐坂の山のはまてゝ入ぬれは影かたふかぬもち月のこま",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜中駒迎",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "しかの浦に泊りをさして清舟のまかせもやらぬよいの月かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "に夜深く思ひしつめて・字時は枕のしたに衣うつなり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣音逗",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "あきの野を心えに身にしめて色に出ける虫の声かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "出声悲",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "うすくこくうつろふ色はしら菊の千葉にもそを分ぬはかりそ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊花色々",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "立田山こへ行岸の夕時雨梢にのみそあとは有ける",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雨後紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "あるしとも頼言し虫は音もせて蓮る閑に冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "閑居初冬",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "水を惜む笹の外は中々に雪にそ草の色は有ける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭草帯霜",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "霜枯る芽の丸屋のほとなきは枕のもとに霰ふるなり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草底聞教",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "なかめやる心の末も道事えぬ雪の朝の塩かまの浦",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪朝飩",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "乙女子か袖ふる夜半のうつりかに匂ひをそふる空の上人",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五節舞姫",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "小舟さす入江は霜そわけやらぬ芦のほすへにをれかはすまに",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雲芦ま江",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "心あらば隅田河原の渡守志はしは思へ千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古渡千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "石はしる音は氷に閉られてまつ風落る布引の滝",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "氷閉滝水",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "誰も皆ひしろによるや待つらん心々のまとひなれとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "網代群遊",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "小夜深き大内山に風さえて雲井を過るあさくらの声",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "禁中神楽",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "御狩野を雪の光にふみ分て帰れは鳥そ面影にたつ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩帰路",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "立のほる煙そみゆる炭竃の小野の外にもとなり有とは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠近炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "年月もをくらぬ宿にいかにして春をむかふ日夜はの埋火",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "埋火し冬",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "年の内に残る日数のあらはこそ聞ても罪の又もつもらめ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "毎日仏名",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "我なからうたて朽木もえにしあへは心の花の下に有ける",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "老後初恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "ちらすなよ其はゝからを尋てもふせやといはん里のしるへそ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恩尋縁恋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "朝夕に夜々にのみしむねりかの重ぬる袖の名残なりせは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "馴不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "逢まてもつらさそ見ゆるかねてより思はゝなとか賢らさるへき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "俄初逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "今はさは難波の芦を刈てたにきみかみそきに逢よしもうな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶五悔恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "思ひやる袖にはしかしあつまのゝ露分いふる歟なりとも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "題題",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "津の国の生田の川に鳥もいは身をかきりとや思ひなさなん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "等思両人",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "うきなからいひ神しよりかはらねは思はすとてもえこそころはね",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋常片思",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "涙さへ伝ふる袖にもらせとや恨むるまゝに身にあまるらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "人伝恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "晨明の月は彼間にかたふきぬひとりやさゝむ海士の釣舟",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "題欠暁見釣舟",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "谷越しの松のふるえやともさるの山伝ひするへとなからん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "酒底古松",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "心から竹の葉そよく音にさへ窓打両とめをさましつゝ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "窓前栽竹",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "岩そゝくたるひの上にむす苔はうき世をいとふ袖かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "苔岩衣",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "山ふかく友よふつるのけしきにも雲の通ひち打詠めつゝ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "仙栖鶴多",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "松かねのたけかり行はもみち葉を袖にこき入る山おろしの風",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遊山端興",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "あゆのふすセゝの岩まにゐるさきのみの毛なみよるかもの川風",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "白鷺立川",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "友もなき野中の庵に日は暮て遥にをくる鐘のをとかな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野亭聞鐘",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "なのりけん鳥のそう音にあらすとも明ぬと見ゆる月にまかせん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜過関路",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "衣手に涼しくわたる河風や人をとゝむるうちのはし娘",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行人休橋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "頼むへき行ゑと見りそ哀なる蛍はかりの海土の漁火",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路日暮",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "かさぬへきつまもこもらぬ武蔵のに袖をはよきにしのくを薄",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇中風冷",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "勅ならてとゝめもすへきわかれかは唐ふねのしはしとるにも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遣唐使船",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "立出てつま木折こし片岡も深き山路と成にける哉",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家送年",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "秋過て山田に立る鹿こそよろはふ賤かよはひなりけり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家老翁",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "逢事は昔にかへる夢路よりね覚の袖をぬらす今のは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夢路古人",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "なき数をはかなく歎く事よりも有を頼むはまさか哀さ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深親夢想",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "昔思ふあかゐの水の雫よりぬるとも袖をしほるなりけり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山寺懐洞",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "いとふへし思ひもすへし鷲の山みのりの末にあふ世なりけり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞法述懐",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "里わかすくもりなき世を思ふかな春日の山の月を詠めて",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733162",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頭祝言",
   "kotobagaki": ""
  }
 ],
